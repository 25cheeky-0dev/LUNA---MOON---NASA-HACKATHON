# Backend (export these before starting uvicorn; no automatic dotenv loading)
WISPR_GRID_DIR=/absolute/path/to/WISPR_Site04_Tiling_V3
WISPR_GLOBAL_ROOT=/absolute/path/to/optional/lunar-v1
CELESTIAL_CACHE_DIR=/absolute/path/to/writable/celestial-cache
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional language provider, server-side only. Leave empty without credentials.
GROQ_API_KEY=
GROQ_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Frontend: place only this setting in frontend/.env.local if required.
VITE_API_BASE_URL=http://localhost:8000
